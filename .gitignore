# === SANGIL STUDIO — .gitignore ===
# REGLA DE SEGURIDAD (proyecto): NUNCA se sincronizan credenciales, keys, API keys,
# tokens de MCPs ni variables de entorno con GitHub. Cada vez que se añada un secreto
# nuevo o un fichero local de configuración de un desarrollador para una integración,
# hay que incluirlo aquí ANTES de subir nada.

# --- Secretos y variables de entorno ---
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
credentials.json
secrets.json
service-account*.json
*.secret
*.secrets
*_secret*
*apikey*
*api-key*
*.token
*token*.json

# --- Códigos de recuperación / ficheros sensibles sueltos ---
recovery-codes.txt
*recovery-code*
*recovery-codes*

# --- MCPs con tokens / credenciales ---
# Ficheros de configuración de MCP que puedan contener tokens de acceso.
.mcp.local.json
mcp.local.json
**/mcp-credentials*.json

# --- Config local de cada desarrollador para integraciones ---
# (settings.local.json SÍ se versiona porque sólo declara rutas de memoria/auto-memoria
#  y NO debe contener secretos; si algún día los contuviera, muévelos a un .env)
*.local.env
.vscode/*.local.json
.idea/

# --- Dependencias / build (según el stack que se elija) ---
node_modules/
dist/
build/
.next/
out/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Sistema operativo ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# --- Assets maestros de imagen (NUNCA al repo) ---
# El ZIP (~1,7 GB) y su contenido descomprimido son el ARCHIVO MAESTRO: se guardan
# en Drive + disco externo, jamás en git. La web sólo versiona los derivados
# optimizados que genera `npm run images` en public/media/.
IMAGENES PROYECTOS.zip
IMAGENES PROYECTOS/
LOGO REDES/

# --- Next.js / Vercel ---
.vercel
next-env.d.ts
*.tsbuildinfo
.env*

# --- Migración a Sanity ---
# Generado por npm run migrate:build a partir de content-snapshot.json.
scripts/migration/import.ndjson

.vercel
.env*
